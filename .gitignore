# Dependencies and generated frontend bundles
**/node_modules/
**/dist/
# 一体化构建产物（由 npm run build 生成）
public/
# 例外：H5 的 PWA 静态资源（sw.js / 图标）属于源码，构建时会复制到产物根目录
!h5/public/
!h5/public/**


# Docker compose 挂载的数据目录（SQLite + 上传文件）
/data/

# Local databases and uploaded user media
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data/uploads/
server/data/backup/

# Local tooling and browser profiles
_npmcache/
_probe/
.workbuddy/
# 本地验收截图，不入库
_shots/

# Local environment secrets
.env
.env.*
!.env.example
