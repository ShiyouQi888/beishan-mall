# 复制成 .env 后按需修改（docker compose 会自动读取同目录的 .env）
# 改完必须 docker compose up -d 让容器按新配置重建；docker compose restart 不会重读 .env
# 注意：.env 已在 .gitignore 里，不要提交进仓库

# ---- 服务 ----
NODE_ENV=production
HOST=0.0.0.0
# 容器内监听端口（改了映射会跟着变）
PORT=3300
# 宿主机端口。留空 = 由 Docker 自动分配一个空闲端口，不会和本机其它服务冲突
# 取实际端口：docker compose port mall 3300
# 想固定就填，例如 APP_PORT=3300
APP_PORT=

# ---- 数据与静态资源 ----
MALL_DB=/app/data/mall.db
UPLOAD_DIR=/app/data/uploads
PUBLIC_DIR=/app/public
# 想让图片返回绝对地址时填，例如 https://mall.example.com；留空返回相对路径
PUBLIC_BASE_URL=

# ---- 安全 ----
# 生产环境务必改成随机长串
JWT_SECRET=please-change-this-secret

# ---- 内置管理员 ----
# 首次启动自动按这两个值创建管理员；账号已存在时不会覆盖密码
ADMIN_USER=admin1
ADMIN_PASSWORD=please-change-this-password
# 忘记密码时设为 1 重启一次可强制改回上面的密码，改完记得改回 0
ADMIN_PASSWORD_RESET=0

# ---- 其它 ----
TZ=Asia/Shanghai
